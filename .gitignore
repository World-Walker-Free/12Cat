# ============================================================
#  猫的十二分类 —— Git 忽略规则
#  仓库只保留代码，不含报告、实验产物与数据集
# ============================================================

# ---------------------- 报告与个人材料 ----------------------
# 含姓名/学号，不上传
实验报告.docx
实验报告.md
实验报告.pdf
第一次作业报告.docx
README - 副本.md

# ------------------------ 实验产物 ------------------------
# 25 个模型权重约 1.1 GB，图表与汇总表为报告配套内容
results/
*.pt
*.pth
*.ckpt

# ------------------------- 数据集 -------------------------
# 约 208 MB，且属课程提供材料
猫的十二分类/

# -------------------- 课程原始文件 --------------------
# 教师提供的作业说明（含教师邮箱）
作业1_大班.pdf

# ------------------------ 提交包 ------------------------
提交包/

# ------------------------- Python -------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ------------------- IDE / 工具状态 -------------------
# .mimocode 含工具会话记录与依赖，约 49 MB
.idea/
.vscode/
.mimocode/

# ------------------- Office 临时锁文件 -------------------
~$*

# ------------------------- 系统文件 -------------------------
Thumbs.db
desktop.ini
.DS_Store
